generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Product {
  id              String   @id @default(cuid())
  sku             String   @unique
  name            String
  slug            String   @unique
  brand           String
  category        String
  categoryType    String   @default("CATEGORY_B") // CATEGORY_A (E-com) or CATEGORY_B (O2O)
  physicalStatus  String   @default("ON_ORDER")   // ACTIVE_KITCHEN, EXHIBITION_15, EXHIBITION_11, ON_ORDER
  price           Float
  oldPrice        Float?
  inStock         Boolean  @default(false)
  stockCount      Int      @default(0)
  shortDesc       String?
  description     String
  featuresJson    String   @default("[]") // Array of { label: string, value: string }
  dimensions      String?  // e.g. "595 x 596 x 568 мм"
  schematicPdfUrl String?  // Link to PDF installation drawing
  imagesJson      String   @default("[]") // Array of image URLs
  badge           String?  // e.g. "Хит", "Флагман", "Премьера"
  isFeatured      Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Lead {
  id                String   @id @default(cuid())
  type              String   // ACTIVE_KITCHEN_TESTDRIVE, SHOWROOM_VISIT, PROJECT_MATCHING, B2B_CLUB, KITCHEN_ESTIMATE, QUICK_CONSULT
  name              String
  phone             String
  email             String?
  preferredDate     String?
  preferredTime     String?
  preferredShowroom String?  // "Белинского, 15" or "Белинского, 11/66"
  productId         String?
  productName       String?
  portfolioUrl      String?
  attachmentPath    String?
  comment           String?
  utmSource         String?
  utmMedium         String?
  utmCampaign       String?
  pageUrl           String?
  status            String   @default("NEW")
  asanaTaskId       String?
  createdAt         DateTime @default(now())
}

model Order {
  id              String   @id @default(cuid())
  orderNumber     String   @unique
  customerName    String
  customerPhone   String
  customerEmail   String?
  deliveryType    String   @default("PICKUP_15") // PICKUP_15, PICKUP_11, WHITE_GLOVE_DELIVERY
  deliveryAddress String?
  totalAmount     Float
  paymentStatus   String   @default("PENDING") // PENDING, PAID, CANCELLED
  paymentId       String?
  itemsJson       String   // Array of { productId, sku, name, price, quantity }
  oneCSynced      Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model ChatMessage {
  id          String   @id @default(cuid())
  sessionId   String
  sender      String   // CLIENT, MANAGER, SYSTEM
  text        String
  tgMessageId Int?
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())
}
