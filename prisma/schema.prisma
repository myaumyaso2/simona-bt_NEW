generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Product {
  id              String   @id @default(cuid())
  sku             String
  name            String
  slug            String   @unique
  brand           String
  category        String
  categoryType    String   @default("CATEGORY_B") // CATEGORY_A (E-com) or CATEGORY_B (O2O)
  productGroup    String?                         // Группа товара 1С (столбец C 1C_import.csv)
  physicalStatus  String   @default("ON_ORDER")   // ACTIVE_KITCHEN, EXHIBITION_15, EXHIBITION_11, ON_ORDER
  price           Float
  oldPrice        Float?
  inStock         Boolean  @default(false)
  stockCount      Int      @default(0)
  stockKominterna Int      @default(0)            // Центральный склад (ул. Коминтерна, 27)
  stockBelinskogo15 Int    @default(0)            // Флагманский салон (ул. Белинского, 15)
  stockRemote     Int      @default(0)            // Удаленные склады дистрибьюторов
  deliveryDays    Int      @default(1)
  oneCGuid        String?                         // Идентификатор номенклатуры 1С
  oldUrl          String?                         // Старый URL UMI.CMS
  color           String?
  shortDesc       String?
  description     String
  featuresJson    String   @default("[]") // Array of { label: string, value: string }
  dimensions      String?  // e.g. "595 x 596 x 568 мм"
  schematicPdfUrl String?  // Link to PDF installation drawing
  imagesJson      String   @default("[]") // Array of image URLs
  badge           String?  // e.g. "Хит", "Флагман", "Премьера"
  isFeatured      Boolean  @default(false)
  isActive        Boolean  @default(true)
  systemArticle   String?                         // Очищенный заводской артикул для связки спецпредложений
  priceOpt        Float?                          // Оптовая цена 1С для менеджеров
  isDiscount      Boolean  @default(false)        // Признак Уценка (колонка 9)
  isSpecial       Boolean  @default(false)        // Признак Спец предложение (колонка 7)
  noPrice         Boolean  @default(false)        // Признак Без цены (колонка 11)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([sku])
  @@index([oneCGuid])
  @@index([systemArticle])
  @@index([isActive])
  @@index([brand])
  @@index([category])
}

model Customer {
  id             String    @id @default(cuid())
  phone          String    @unique // Нормализованный телефон +7XXXXXXXXXX (или UMI-{umiObjectId})
  email          String?
  name           String
  passwordHash   String?   // Современный хэш пароля (scrypt/bcrypt)
  legacyPassword String?   // Legacy-хэш пароля из UMI.CMS (MD5 / SHA256+HASH_SALT)
  role           String    @default("CLIENT") // CLIENT, DESIGNER
  companyName    String?   // Юрлицо / Бренд B2B-партнера
  address        String?   // Основной адрес доставки клиента
  otpCode        String?   // Разовый 6-значный код входа по Email
  otpExpiresAt   DateTime? // Срок действия OTP-кода
  umiObjectId    Int?      @unique // ID объекта пользователя в UMI.CMS
  bonusPoints    Int       @default(0)
  orders         Order[]
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([email])
}

model Lead {
  id                String   @id @default(cuid())
  type              String   // ACTIVE_KITCHEN_TESTDRIVE, SHOWROOM_VISIT, PROJECT_MATCHING, B2B_CLUB, B2B_OPT, KITCHEN_ESTIMATE, QUICK_CONSULT, EQUIPMENT_SELECTION, PRICE_MATCH
  name              String
  phone             String
  email             String?
  preferredDate     String?
  preferredTime     String?
  preferredShowroom String?  // "Белинского, 15" or "Белинского, 11/66"
  productId         String?
  productName       String?
  portfolioUrl      String?
  attachmentPath    String?
  comment           String?
  utmSource         String?
  utmMedium         String?
  utmCampaign       String?
  utmContent        String?
  utmTerm           String?
  ymClientId        String?
  yclid             String?
  pageUrl           String?
  status            String   @default("NEW")
  asanaTaskId       String?
  createdAt         DateTime @default(now())
}

model Order {
  id              String      @id @default(cuid())
  orderNumber     String      @unique
  umiOrderId      Int?        @unique
  customerId      String?
  customer        Customer?   @relation(fields: [customerId], references: [id])
  customerName    String
  customerPhone   String
  customerEmail   String?
  deliveryType    String      @default("PICKUP_WAREHOUSE_KOMINTERNA") // PICKUP_WAREHOUSE_KOMINTERNA, PICKUP_BELINSKOGO_15, COURIER_DELIVERY
  deliveryAddress String?
  deliveryDate    String?
  deliveryComment String?
  totalAmount     Float
  status          String      @default("NEW")     // NEW, IN_PROGRESS, CONFIRMED, PAID, READY_FOR_PICKUP, DELIVERED, CANCELLED, TEST
  isOneClick      Boolean     @default(false)
  paymentStatus   String      @default("PENDING") // PENDING, HOLD, PAID, CANCELLED, REFUNDED
  paymentMethod   String      @default("IN_SALON") // IN_SALON, CARD_ONLINE, ON_RECEIPT, B2B_INVOICE
  paymentId       String?
  paymentLink     String?                       // Персональная платежная ссылка ЮKassa
  companyName     String?
  companyInn      String?
  itemsJson       String      // Array of { productId, sku, name, price, quantity, brand, image, physicalStatus }
  orderItems      OrderItem[]
  ymClientId      String?
  yclid           String?
  utmSource       String?
  utmMedium       String?
  utmCampaign     String?
  utmContent      String?
  utmTerm         String?
  asanaTaskId     String?
  oneCSynced      Boolean     @default(false)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([customerId])
  @@index([customerPhone])
  @@index([paymentId])
}

model OrderItem {
  id             String  @id @default(cuid())
  orderId        String
  order          Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId      String?
  sku            String?
  name           String
  brand          String?
  price          Float
  quantity       Int     @default(1)
  image          String?
  slug           String?
  physicalStatus String?

  @@index([orderId])
  @@index([sku])
}

model Redirect301 {
  id        String   @id @default(cuid())
  oldPath   String   @unique
  newPath   String
  createdAt DateTime @default(now())

  @@index([oldPath])
}

model ChatMessage {
  id           String   @id @default(cuid())
  sessionId    String
  sender       String   // CLIENT, MANAGER, SYSTEM
  text         String
  clientName   String?
  clientPhone  String?
  pageUrl      String?
  tgMessageId  Int?
  maxMessageId String?
  isRead       Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@index([sessionId])
}
