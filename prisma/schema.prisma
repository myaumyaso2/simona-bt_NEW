generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Product {
  id              String   @id @default(cuid())
  sku             String
  name            String
  slug            String   @unique
  brand           String
  category        String
  categoryType    String   @default("CATEGORY_B") // CATEGORY_A (E-com) or CATEGORY_B (O2O)
  physicalStatus  String   @default("ON_ORDER")   // ACTIVE_KITCHEN, EXHIBITION_15, EXHIBITION_11, ON_ORDER
  price           Float
  oldPrice        Float?
  inStock         Boolean  @default(false)
  stockCount      Int      @default(0)
  stockKominterna Int      @default(0)            // Центральный склад (ул. Коминтерна, 27)
  stockBelinskogo15 Int    @default(0)            // Флагманский салон (ул. Белинского, 15)
  stockRemote     Int      @default(0)            // Удаленные склады дистрибьюторов
  deliveryDays    Int      @default(1)
  oneCGuid        String?                         // Идентификатор номенклатуры 1С
  oldUrl          String?                         // Старый URL UMI.CMS
  color           String?
  shortDesc       String?
  description     String
  featuresJson    String   @default("[]") // Array of { label: string, value: string }
  dimensions      String?  // e.g. "595 x 596 x 568 мм"
  schematicPdfUrl String?  // Link to PDF installation drawing
  imagesJson      String   @default("[]") // Array of image URLs
  badge           String?  // e.g. "Хит", "Флагман", "Премьера"
  isFeatured      Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([sku])
  @@index([brand])
  @@index([category])
}

model Lead {
  id                String   @id @default(cuid())
  type              String   // ACTIVE_KITCHEN_TESTDRIVE, SHOWROOM_VISIT, PROJECT_MATCHING, B2B_CLUB, KITCHEN_ESTIMATE, QUICK_CONSULT
  name              String
  phone             String
  email             String?
  preferredDate     String?
  preferredTime     String?
  preferredShowroom String?  // "Белинского, 15" or "Белинского, 11/66"
  productId         String?
  productName       String?
  portfolioUrl      String?
  attachmentPath    String?
  comment           String?
  utmSource         String?
  utmMedium         String?
  utmCampaign       String?
  utmContent        String?
  utmTerm           String?
  ymClientId        String?
  yclid             String?
  pageUrl           String?
  status            String   @default("NEW")
  asanaTaskId       String?
  createdAt         DateTime @default(now())
}

model Order {
  id              String   @id @default(cuid())
  orderNumber     String   @unique
  customerName    String
  customerPhone   String
  customerEmail   String?
  deliveryType    String   @default("PICKUP_WAREHOUSE_KOMINTERNA") // PICKUP_WAREHOUSE_KOMINTERNA, PICKUP_BELINSKOGO_15, WHITE_GLOVE_DELIVERY
  deliveryAddress String?
  deliveryDate    String?
  deliveryComment String?
  totalAmount     Float
  status          String   @default("NEW")     // NEW, CONFIRMED, PAID, READY_FOR_PICKUP, DELIVERED, CANCELLED
  paymentStatus   String   @default("PENDING") // PENDING, PAID, CANCELLED
  paymentMethod   String   @default("IN_SALON") // IN_SALON, CARD_ONLINE, ON_RECEIPT, B2B_INVOICE
  paymentId       String?
  itemsJson       String   // Array of { productId, sku, name, price, quantity, brand, image }
  ymClientId      String?
  yclid           String?
  utmSource       String?
  utmMedium       String?
  utmCampaign     String?
  utmContent      String?
  utmTerm         String?
  oneCSynced      Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Redirect301 {
  id        String   @id @default(cuid())
  oldPath   String   @unique
  newPath   String
  createdAt DateTime @default(now())

  @@index([oldPath])
}

model ChatMessage {
  id          String   @id @default(cuid())
  sessionId   String
  sender      String   // CLIENT, MANAGER, SYSTEM
  text        String
  tgMessageId Int?
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())
}
